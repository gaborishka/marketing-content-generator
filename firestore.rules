rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} { allow read, write: if request.auth != null; }
    match /campaigns/{id} { allow read, write: if request.auth != null; }
    match /content/{id} { allow read, write: if request.auth != null; }
    match /complianceRules/{id} { allow read, write: if request.auth != null; }
    match /{document=**} { allow read, write: if false; }
  }
}
